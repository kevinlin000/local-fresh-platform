{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/main.ts",
    "src/router.ts",
    "src/permission.ts",
    "src/App.vue",
    "src/store/**/*.ts",
    "src/utils/request.ts",
    "src/utils/cookies.ts",
    "src/api/employee.ts",
    "src/views/vue3/**/*.vue"
  ],
  "references": []
}
