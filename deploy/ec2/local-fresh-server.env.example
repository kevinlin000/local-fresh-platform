# Copy this file to /etc/local-fresh/local-fresh-server.env on EC2.
# Replace every placeholder with the real EC2/RDS/S3/OAuth/payment value.
# Do not commit the filled runtime env file.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=Asia/Taipei

# Deployment identity exposed through /actuator/info.
SOURCE_COMMIT=replace-me
SOURCE_BRANCH=hardening-and-upgrade
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# Database.
DB_HOST=replace-me
DB_PORT=3306
DB_NAME=local_fresh
DB_USERNAME=replace-me
DB_PASSWORD=replace-me

# Redis.
REDIS_HOST=replace-me
REDIS_PORT=6379
REDIS_DATABASE=0

# Public frontend/API origins.
CORS_ALLOWED_ORIGIN_PATTERNS=https://replace-me.cloudfront.net,https://localfresh-demo.duckdns.org
GROUP_BUY_SHARE_BASE_URL=https://replace-me.cloudfront.net/groupBuy
GOOGLE_OAUTH_REDIRECT_URI=https://replace-me.cloudfront.net/oauth/callback

# JWT secrets must be long random strings.
JWT_ADMIN_SECRET=replace-with-at-least-32-byte-secret
JWT_USER_SECRET=replace-with-at-least-32-byte-secret
JWT_ADMIN_TTL_MS=28800000
JWT_USER_TTL_MS=604800000

# AWS S3.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=replace-me

# Google APIs.
GOOGLE_MAPS_API_KEY=replace-me
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# Shop identity.
SHOP_ADDRESS=replace-me

# Payment. Keep demo until public ECPay callback preflight passes.
PAYMENT_PROVIDER=demo
PAYMENT_CALLBACK_SECRET=replace-with-demo-callback-secret
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_CHECKOUT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
ECPAY_RETURN_URL=https://localfresh-demo.duckdns.org/payment/callback
ECPAY_ORDER_RESULT_URL=https://replace-me.cloudfront.net/orders
