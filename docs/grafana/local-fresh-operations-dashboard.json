          },
          "editorMode": "code",
          "expr": "sum by (provider, result) (increase(localfresh_payment_reconciliation_total{provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} / {{result}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Payment Reconciliation Outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Order cancellation idempotency signal. Duplicate skips should stay low and explainable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
