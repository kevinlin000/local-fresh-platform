<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <select id="getSetmealIdsByDishIds" resultType="java.lang.Long">
        select gift_box_id from gift_box_product where product_id in
        <foreach collection="dishIds" item="productId" separator="," open="(" close=")">
            #{productId}
        </foreach>
    </select>

    <insert id="insertBatch" parameterType="list">
        insert into gift_box_product
        (gift_box_id,product_id,name,price,copies)
        values
        <foreach collection="giftBoxProducts" item="sd" separator=",">
            (#{sd.giftBoxId},#{sd.productId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>

</mapper>
